      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks your transactions, cards and statements for broken links and fixes what it can. A backup is saved first. Nothing is deleted."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica suas transações, cartões e faturas em busca de vínculos quebrados e corrige o que for possível. Um backup é salvo antes. Nada é excluído."
          }
        }
      }
    },
