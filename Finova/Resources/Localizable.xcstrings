          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir zonas de grupos não usadas?"
          }
        }
      }
    },
    "syncSettings.purgeZones.title": {
      "extractionState": "manual",
      "localizations": {
