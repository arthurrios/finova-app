      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps one budget allocation per category each month and removes the extras. It does not change any transaction, so corrections you made by hand are left alone. A backup is saved first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém uma alocação de orçamento por categoria em cada mês e remove as extras. Não altera nenhuma transação, então as correções que você fez manualmente são preservadas. Um backup é salvo antes."
          }
        }
      }
    },
