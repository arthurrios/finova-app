<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Finova Demo (build configuration `Demo`, bundle ID com.arthurrios.FinanceApp.demo).
	Deliberately has NO iCloud, CloudKit, key-value store or push entitlements, so the demo build is
	physically unable to reach the production container or the real app's data. Do not add them.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
