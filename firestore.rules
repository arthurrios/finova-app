rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App config is readable by all authenticated users, writable only by admins
    match /app_config/{document} {
      allow read: if true;
      allow write: if false; // Only writable via Firebase Console or Admin SDK
    }

    // Notification logs are only accessible by admin
    match /notification_logs/{document} {
      allow read, write: if false;
    }
  }
}
